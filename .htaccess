# Le dépôt est déployé tel quel sur le serveur : seul le site statique est public.
# L'API (server/) n'est joignable que via le ProxyPass /api/ du vhost.
# Aucun fichier caché (.env, .git, .gitignore...) sauf ACME pour Let's Encrypt.
RedirectMatch 404 "/\.(?!well-known/)"
RedirectMatch 404 "^/server(/|$)"

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force le slash final sur /en
    RewriteRule ^en$ /en/ [R=301,L]

    # Redirections 301 : index.html -> racine propre
    RewriteRule ^index\.html$ / [R=301,L]
    RewriteRule ^en/index\.html$ /en/ [R=301,L]

    # Redirection 301 : toute page .html -> URL propre (sans .html)
    # ex: /brutalisme.html -> /brutalisme , /en/webgl.html -> /en/webgl
    RewriteCond %{THE_REQUEST} \s/+([^.\s]+)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # Réécriture interne propre (l'utilisateur ne voit jamais le .html)
    # Racine /
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^$ index.html [L]

    # Dossier /en/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^en/?$ en/index.html [L]

    # Pages /en/<page>
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^en/([^/]+)/?$ en/$1.html [L]

    # Pages racine /<page>
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([^/]+)/?$ $1.html [L]
</IfModule>
