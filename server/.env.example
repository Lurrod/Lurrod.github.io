# Local dev: copy to server/.env (never committed) and run `npm start`.
# Production: same file, /var/www/titouan-borde.com/server/.env (chmod 600, never served).
PORT=3400

# OVH mailbox used to send (SMTP ssl0.ovh.net:465 by default)
MAIL_USER=contact@titouan-borde.com
MAIL_PASS=
# Where form messages are delivered
MAIL_TO=contact@titouan-borde.com

# Comma-separated origins allowed to post the form
ALLOWED_ORIGINS=https://titouan-borde.com,https://www.titouan-borde.com

# Optional overrides
# SMTP_HOST=ssl0.ovh.net
# SMTP_PORT=465
